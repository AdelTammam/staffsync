# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Create a free cluster at https://cloud.mongodb.com
# Replace <username>, <password>, and <cluster> with your own values.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=staffsync

# ─── NextAuth v5 ─────────────────────────────────────────────────────────────
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET=your-secret-here-at-least-32-characters-long
NEXTAUTH_URL=http://localhost:3000

# ─── How to create the first admin user ──────────────────────────────────────
# 1. Register a regular account at /register
# 2. Open MongoDB Atlas → Browse Collections → users
# 3. Find your user document and change "role": "user" to "role": "admin"
# 4. Sign out and sign back in — you will now have admin access.
